# Copy to .env, then: docker compose up --build

# Needed for the AI assistant on the job page (https://console.groq.com/keys).
# Everything else works without it.
GROQ_API_KEY=

# Port for the web app on your machine (change if 3000 is taken).
WEB_PORT=3000

# Optional: timezone used to decide when a job's closing date has passed.
# APP_TIMEZONE=Asia/Kolkata

# Sign-in (JWT). Use a long random secret outside local dev.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Account created on first start (you can also sign up in the app).
ADMIN_EMAIL=recruiter@example.com
ADMIN_PASSWORD=password123
