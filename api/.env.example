# For running the API outside Docker (npm run dev). Postgres comes from
# `docker compose up -d db` (host port 5433).
DATABASE_URL=postgresql://ats:ats@localhost:5433/ats?schema=public

PORT=4000
# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ORIGIN=http://localhost:3000
# Timezone used to decide when a job's closing date has passed.
APP_TIMEZONE=Asia/Kolkata

