# For running the API outside Docker (npm run dev). Postgres comes from
# `docker compose up -d db` (host port 5433).
DATABASE_URL=postgresql://ats:ats@localhost:5433/ats?schema=public

PORT=4000
# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ORIGIN=http://localhost:3000
# Timezone used to decide when a job's closing date has passed.
APP_TIMEZONE=Asia/Kolkata

# AI assistant (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sign-in. JWT_SECRET signs access tokens: use a long random string (32+ chars).
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# Created on startup if it doesn't exist yet.
ADMIN_EMAIL=recruiter@example.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Demo Recruiter
